---
import { projectSchema } from "../models/project";
import ProjectCard from "./project-card.astro";
import { Spreadsheet } from "sheethuahua";

const projects = await Spreadsheet(
  "1A2O_Tz8pZPfJ_QqsPFX0DbosoXcSEGAahPAj-EM5fjc",
).get("Sheet1", projectSchema);

const maxProjectPerColumn = Math.ceil(projects.length / 2);
---

<section class="bg-black">
  <div class="justify-center flex flex-col py-4 md:py-8 gap-4 md:gap-8">
    <h2 class="text-h2 text-center text-green-2 font-bold">
      {projects.length} PROJECTS
    </h2>

    <div class="grid md:grid-cols-2 gap-3">
      {
        [
          [0, maxProjectPerColumn],
          [maxProjectPerColumn, projects.length],
        ].map(([from, to]) => (
          <div class="flex flex-col gap-3">
            {projects.slice(from, to).map((project, i) => {
              const fileName = from + i + 2;
              return (
                <ProjectCard
                  {...project}
                  projectImage={`${import.meta.env.BASE_URL}/images/projects/${fileName}.webp`}
                  creatorImage={`${import.meta.env.BASE_URL}/images/creators/${fileName}.webp`}
                />
              );
            })}
          </div>
        ))
      }
    </div>
  </div>
</section>
